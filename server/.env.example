# Materiaalhok-SF — e-mailconfiguratie.
# Kopieer dit bestand naar server/.env en vul de waarden in.
# server/.env staat in .gitignore en komt nooit in de repo.

# off      = niets versturen, alleen in de console loggen wat er gestuurd zou zijn (veilige standaard tijdens ontwikkeling).
# redirect = wél echt versturen, maar altijd naar MAIL_REDIRECT_TO. Handig om templates te testen zonder een gebruiker te spammen.
# live     = versturen naar de echte ontvanger.
MAIL_MODE=off

# Verplicht als MAIL_MODE=redirect. Bij redirect wordt de originele ontvanger als banner in de mail opgenomen.
MAIL_REDIRECT_TO=

# SMTP-server. Voor Gmail: smtp.gmail.com poort 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Inloggegevens voor de SMTP-server. Voor Gmail is SMTP_USER het volledige adres.
SMTP_USER=materiaalhokopwest@gmail.com

# Gmail vereist een 16-tekens app-wachtwoord (géén gewoon wachtwoord). Zonder spaties invullen.
# Aanmaken: https://myaccount.google.com/apppasswords (tweestapsverificatie moet aan staan).
SMTP_PASS=

# De naam die als afzender in de mail komt te staan; e-mailadres wordt SMTP_USER.
MAIL_FROM_NAME=Materiaalhok Opsterland

# Tijdzone voor het verzendvenster (08:00–18:00 op werkdagen, zie BESLUITEN.md).
# Bevestigingsmails gaan direct — het venster geldt alleen voor geplande mails.
APP_TIMEZONE=Europe/Amsterdam
